/* pages/index/index.wxss */

page {
  background: #f4f5f7;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  color: #1f2329;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  /* 给底部固定操作区留出空间（含 iPhone 安全区） */
  padding: 24rpx 24rpx calc(360rpx + env(safe-area-inset-bottom));
}

/* ================= 顶部标题 ================= */
.hero {
  padding: 32rpx 28rpx 36rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #4a6cf7 0%, #6f5cf6 100%);
  box-shadow: 0 12rpx 28rpx rgba(74, 108, 247, 0.28);
}

.hero__title {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 1rpx;
}

.hero__sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.86);
}

/* 本地调试时的后端地址提示 */
.hero__dev {
  display: inline-block;
  margin-top: 20rpx;
  padding: 8rpx 16rpx;
  border-radius: 10rpx;
  background: rgba(0, 0, 0, 0.18);
  font-size: 22rpx;
  color: #ffffff;
}

/* ================= 卡片 ================= */
.panel {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(31, 35, 41, 0.05);
}

.panel__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.panel__title {
  font-size: 28rpx;
  font-weight: 600;
}

.panel__count {
  font-size: 24rpx;
  color: #8b93a3;
}

/* ================= 空状态 ================= */
.empty {
  padding: 56rpx 0 64rpx;
  text-align: center;
  border: 2rpx dashed #d9dde6;
  border-radius: 16rpx;
  background: #fafbfd;
}

.empty__icon {
  font-size: 64rpx;
  line-height: 1;
}

.empty__title {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #4e5769;
}

.empty__desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9aa2b1;
}

/* ================= 图片网格 ================= */
.grid {
  display: flex;
  flex-wrap: wrap;
}

/* 排序模式：给可拖动的格子加一圈提示（用 box-shadow，不改布局尺寸） */
.grid--sorting .cell--pic {
  box-shadow: 0 0 0 4rpx rgba(74, 108, 247, 0.45);
}

.cell {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin: 0 14rpx 14rpx 0;
  border-radius: 16rpx;
  overflow: hidden;
  background: #eef0f5;
}

/* 每行 3 个，去掉最后多余的右边距 */
.cell:nth-child(3n) {
  margin-right: 0;
}

/* 拖动中的格子：脱离文档流跟着手指跑，其它格子自动让位 */
.grid .cell--dragging {
  position: fixed;
  z-index: 20;
  margin: 0;
  opacity: 0.92;
  transform: scale(1.08);
  box-shadow: 0 16rpx 40rpx rgba(31, 35, 41, 0.35);
}

.cell__img {
  width: 100%;
  height: 100%;
  display: block;
  /* 旋转过渡：点 ⟳ 时能看到方向变化，而不是突变 */
  transition: transform 0.2s ease-out;
}

.cell__badge {
  position: absolute;
  left: 10rpx;
  bottom: 10rpx;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #ffffff;
  font-size: 22rpx;
  line-height: 36rpx;
  text-align: center;
}

/* 旋转按钮：左上角 */
.cell__rot {
  position: absolute;
  left: 0;
  top: 0;
  width: 52rpx;
  height: 52rpx;
  border-bottom-right-radius: 16rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #ffffff;
  font-size: 30rpx;
  line-height: 52rpx;
  text-align: center;
}

.cell__rot:active {
  background: rgba(74, 108, 247, 0.9);
}

.cell__del {
  position: absolute;
  right: 0;
  top: 0;
  width: 52rpx;
  height: 52rpx;
  border-bottom-left-radius: 16rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #ffffff;
  font-size: 26rpx;
  line-height: 52rpx;
  text-align: center;
}

.cell__del:active {
  background: rgba(250, 81, 81, 0.9);
}

/* 排序模式的 ‹ › 按钮（拖动不好用时的兜底方案） */
.cell__move {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  height: 48rpx;
  background: rgba(31, 35, 41, 0.6);
}

.cell__movebtn {
  flex: 1;
  color: #ffffff;
  font-size: 32rpx;
  line-height: 48rpx;
  text-align: center;
}

.cell__movebtn:active {
  background: rgba(74, 108, 247, 0.9);
}

/* 排序模式提示条 */
.sortbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
  padding: 14rpx 18rpx;
  border-radius: 14rpx;
  background: #f0f3ff;
}

.sortbar__hint {
  font-size: 22rpx;
  color: #3b5be0;
}

.sortbar__done {
  font-size: 24rpx;
  font-weight: 600;
  color: #ffffff;
  padding: 6rpx 22rpx;
  border-radius: 24rpx;
  background: #4a6cf7;
}

/* ================= 隐藏 canvas（旋转用） ================= */
.offscreen-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 2px;
  height: 2px;
}

/* 追加格子 */
.cell--add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #c9d0dd;
  background: #fafbfd;
}

.cell--add:active {
  background: #f0f3fa;
}

.cell__plus {
  font-size: 48rpx;
  line-height: 1;
  color: #8b93a3;
}

.cell__addtext {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9aa2b1;
}

/* ================= 排版模式 ================= */
.opts {
  display: flex;
}

.opt {
  flex: 1;
  padding: 20rpx 18rpx;
  border: 2rpx solid #e3e7ee;
  border-radius: 16rpx;
  background: #fafbfd;
}

.opt:first-child {
  margin-right: 16rpx;
}

.opt--on {
  border-color: #4a6cf7;
  background: #f0f3ff;
}

.opt__name {
  font-size: 26rpx;
  font-weight: 600;
  color: #4e5769;
}

.opt--on .opt__name {
  color: #3b5be0;
}

.opt__desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: #9aa2b1;
}

/* ================= 底部固定操作区 ================= */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 2rpx solid #ebedf2;
  box-shadow: 0 -6rpx 20rpx rgba(31, 35, 41, 0.06);
}

.footer__meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.footer__hint {
  font-size: 22rpx;
  color: #9aa2b1;
}

.footer__clear {
  font-size: 24rpx;
  color: #fa5151;
  padding: 6rpx 12rpx;
}

/* 按钮：必须重置原生 button 的默认边框与背景 */
.btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  padding: 0;
  margin: 0;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 46rpx;
  border: none;
}

.btn::after {
  border: none;
}

.btn--ghost {
  color: #4a6cf7;
  background: #ffffff;
  border: 2rpx solid #b9c6fb;
}

.btn--primary {
  margin-top: 16rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #4a6cf7 0%, #6f5cf6 100%);
  box-shadow: 0 10rpx 22rpx rgba(74, 108, 247, 0.3);
}

.btn--hover {
  opacity: 0.85;
}

.btn[disabled] {
  opacity: 0.5;
  color: #ffffff;
  background: #b6bccb;
  box-shadow: none;
}

.btn--ghost[disabled] {
  color: #9aa2b1;
  background: #f4f5f7;
  border-color: #e3e7ee;
}
