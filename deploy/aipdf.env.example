# 服务器端 .env（docker compose / docker --env-file 使用）
# 复制为 /opt/aipdf/.env 后按需修改

DEBUG=false
PDF_ENGINE=auto
PAGE_MODE=fit

# 【必填】生成的 PDF 对外公网前缀，必须与 Nginx 的 HTTPS 域名一致
PUBLIC_BASE_URL=https://pdf.yourdomain.com

# 容器内路径（与 docker-compose.yml 的挂载一致，一般不用改）
STATIC_DIR=/app/static
PDF_SUBDIR=pdfs
VAR_DIR=/app/var
UPLOAD_SUBDIR=uploads

# 清理策略
PDF_TTL_HOURS=24
UPLOAD_TTL_MINUTES=60
CLEANUP_INTERVAL_MINUTES=60

# 上传限制（client_max_body_size 要 ≥ MAX_REQUEST_BODY_MB）
MAX_FILE_SIZE_MB=15
MAX_TOTAL_SIZE_MB=120
MAX_REQUEST_BODY_MB=120
MAX_FILE_COUNT=30
MAX_IMAGE_SIDE=4096

# 页边距（毫米），打印留白可设 5
PAGE_MARGIN_MM=0
JPEG_QUALITY=90

# CORS：小程序请求不带 Origin，主要给 H5 / 后台页面用
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false
