/* ===========================================================================
 * Creamy Blossom · 设计变量（可直接 @import）
 * 用法：在页面 wxss 顶部 @import "../../assets/..."; 或整段复制到页面顶部。
 * 说明见 ../references/tokens.md
 * =========================================================================== */
page {
  /* 底色 */
  --c-bg-1: #fff5f8;
  --c-bg-2: #fbf3ff;
  --c-bg-3: #f5f8ff;
  --c-surface: #ffffff;
  --c-surface-soft: #fff9fb;

  /* 主色与辅助色（亮色只做填充，深色写文字/图标） */
  --c-primary: #ff7fa8;
  --c-primary-deep: #c22a5f;
  --c-primary-soft: #ffe6ef;
  --c-lilac: #b69cff;
  --c-lilac-soft: #f0e9ff;
  --c-peach: #ffb58c;
  --c-mint: #7ed3be;

  /* 文字 */
  --c-text-1: #4b3a50;
  --c-text-2: #75627e;
  --c-text-3: #9b8ea3;
  --c-line: #f3e7ef;
  --c-danger: #cf3a63;

  /* 渐变 */
  --g-primary: linear-gradient(135deg, #dd4b80 0%, #cd3f74 55%, #9b4fd8 100%);
  --g-hero: linear-gradient(140deg, #fff1f7 0%, #fdeffa 45%, #f3eeff 100%);
  --g-soft: linear-gradient(160deg, #fff7fa 0%, #fbf2ff 55%, #f4f7ff 100%);
  --g-progress: linear-gradient(90deg, #ffa8c4 0%, #dd4b80 50%, #9b4fd8 100%);
  --g-photo: linear-gradient(150deg, #fff3f7 0%, #f6f1ff 100%);

  /* 阴影（一律带主色相） */
  --sh-card: 0 12rpx 32rpx rgba(236, 92, 144, 0.1), 0 2rpx 6rpx rgba(75, 58, 80, 0.04);
  --sh-float: 0 18rpx 44rpx rgba(217, 66, 122, 0.22);
  --sh-btn: 0 14rpx 28rpx rgba(221, 75, 128, 0.32);
  --sh-ring: inset 0 0 0 2rpx rgba(255, 127, 168, 0.16);

  /* 圆角与间距 */
  --r-xs: 12rpx;
  --r-sm: 20rpx;
  --r-md: 28rpx;
  --r-lg: 36rpx;
  --r-pill: 999rpx;
  --sp-1: 8rpx;
  --sp-2: 16rpx;
  --sp-3: 24rpx;
  --sp-4: 32rpx;
  --sp-5: 48rpx;

  /* 动效（--anim-loop 供无限循环动画使用，尊重系统「减少动态效果」） */
  --d-fast: 150ms;
  --d-base: 220ms;
  --d-slow: 1600ms;
  --ease: cubic-bezier(0.32, 0.72, 0, 1);
  --anim-loop: infinite;
}

/* 尊重系统「减少动态效果」 */
@media (prefers-reduced-motion: reduce) {
  page {
    --d-fast: 1ms;
    --d-base: 1ms;
    --d-slow: 1ms;
    --anim-loop: 1;
  }
}
