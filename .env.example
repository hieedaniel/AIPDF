# ===== 复制为 .env 后按需修改（环境变量优先级高于 .env）=====

# ---- 基础 ----
DEBUG=false
API_PREFIX=/api/v1

# ---- 静态资源 / 公网地址 ----
# 小程序里请求的必须是 HTTPS 且已在「小程序后台 → 开发管理 → 服务器域名」中配置
PUBLIC_BASE_URL=https://yourdomain.com
STATIC_DIR=./static
PDF_SUBDIR=pdfs
# 暂存上传原图的运行时目录（不对外公开）
VAR_DIR=./var
UPLOAD_SUBDIR=uploads
UPLOAD_TTL_MINUTES=30
PDF_TTL_HOURS=24
CLEANUP_INTERVAL_MINUTES=60

# ---- 上传限制 ----
MAX_FILE_SIZE_MB=15
MAX_TOTAL_SIZE_MB=80
MAX_REQUEST_BODY_MB=120
MAX_FILE_COUNT=20
MAX_IMAGE_SIDE=4096
# ---- PDF 生成 ----
# auto | pymupdf | reportlab
PDF_ENGINE=auto
# fit | split
PAGE_MODE=fit
PAGE_MARGIN_MM=0
JPEG_QUALITY=90

# ---- CORS（逗号分隔；小程序请求无 Origin，此项主要给 H5/后台调试用）----
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false
